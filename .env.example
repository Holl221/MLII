# Пример файла настроек. Скопируйте его в .env и впишите свои значения.
# Файл .env НЕ попадает в git — ключи останутся только у вас.

# Какую языковую модель использовать: stub | gigachat | yandexgpt | openai
LLM_PROVIDER=stub

# GigaChat (Сбер)
GIGACHAT_CREDENTIALS=

# YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# OpenAI-совместимый API (OpenAI, локальные модели и т.п.)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
